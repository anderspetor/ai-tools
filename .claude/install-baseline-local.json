{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(docker *)",
      "Bash(podman *)",
      "Bash(systemctl *)",
      "Bash(crontab *)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(npm install * -g*)",
      "Bash(npm i * -g*)",
      "Bash(npm install *--global*)",
      "Bash(npm i *--global*)",
      "Bash(pip install *--user*)",
      "Bash(pip3 install *--user*)",
      "Bash(pip install *--break-system-packages*)",
      "Bash(pip3 install *--break-system-packages*)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(* ~)",
      "Bash(* ~/*)",
      "Bash(* $HOME*)",
      "Bash(* ${HOME}*)",
      "Bash(* /home/*)",
      "Bash(* */home/*)"
    ],
    "deny": [
      "Read(//etc/**)",
      "Edit(//etc/**)",
      "Write(//etc/**)",
      "Edit(//home/*/.bashrc)",
      "Write(//home/*/.bashrc)",
      "Edit(//home/*/.bash_profile)",
      "Write(//home/*/.bash_profile)",
      "Edit(//home/*/.profile)",
      "Write(//home/*/.profile)",
      "Edit(//home/*/.zshrc)",
      "Write(//home/*/.zshrc)",
      "Edit(//home/*/.config/autostart/**)",
      "Write(//home/*/.config/autostart/**)",
      "Edit(//home/*/.config/systemd/user/**)",
      "Write(//home/*/.config/systemd/user/**)",
      "Bash(sudo)",
      "Bash(sudo *)",
      "Bash(su)",
      "Bash(su *)"
    ]
  }
}
